#!/bin/sh

set -eu

case "${1:-}" in
trace)
	dd if=/dev/mem bs=1 skip=$((0x81299fc0)) count=4096 2>/dev/null |
		strings -n 4
	;;
mailbox)
	for name_addr in remote-fifo:0x43033060 local-fifo:0x49102060 \
			remote-irq-en:0x43033020 local-irq-en:0x49102020; do
		name=${name_addr%:*}
		addr=${name_addr#*:}
		printf '%-15s %s %s\n' "$name" "$addr" \
			"$(devmem "$addr")"
	done
	;;
state)
	for name_addr in boot-addr:0x43030204 work-mode:0x43030248 \
			core-gate:0x42001080 ts-gate:0x4200100c \
			rv-reset:0x42001090 e907-reset:0x4200109c \
			aon-e907-clk:0x4a010584 \
			aon-peri-pll:0x4a010020; do
		name=${name_addr%:*}
		addr=${name_addr#*:}
		printf '%-15s %s %s\n' "$name" "$addr" \
			"$(devmem "$addr")"
	done
	;;
spi)
	for name_addr in PC-CFG0:0x42000060 PC-CFG1:0x42000064 \
			PC-DRV0:0x42000074 PC-DRV1:0x42000078 \
			PC-PULL0:0x42000084 PC-PULL1:0x42000088 \
			GC:0x44f00004 GCA:0x44f00008 \
			TC:0x44f0000c INT-STA:0x44f00018 \
			PHC:0x44f00020 TCS:0x44f00028 \
			TNM:0x44f0002c DMA:0x44f00040 \
			DSC:0x44f00044 CFT:0x44f0004c \
			CFS:0x44f00050; do
		name=${name_addr%:*}
		addr=${name_addr#*:}
		printf '%-15s %s %s\n' "$name" "$addr" \
			"$(devmem "$addr")"
	done
	;;
*)
	echo "Usage: $0 {trace|mailbox|state|spi}" >&2
	exit 2
	;;
esac
